{
	"name": "Existing Docker Compose (Extend)",
	"dockerComposeFile": [
		"../docker-compose.yml",
		"docker-compose.yml"
	],
	"service": "backend",
	"workspaceFolder": "/server",
	"postCreateCommand": "npm install",
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"eamodio.gitlens"
			],
			"settings": {
				"editor.formatOnSave": true
			}
		}
	}
}